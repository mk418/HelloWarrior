# BigWigs packager config. Used by the CurseForge / WowInterface
# release-builder GitHub Action and by `release.sh` runs locally.

package-as: HelloWarrior

# Files that should NOT end up in the released zip. The packager
# already excludes hidden files by default, but listing key items
# explicitly avoids surprises.
ignore:
    - .gitignore
    - .pkgmeta
    - .github
    - DESIGN.md
    - README.md
    # Project image for CurseForge, not something the client needs to download.
    # Icon.png is deliberately not listed here — the TOC's IconTexture points at
    # it, so it has to ship.
    - HelloWarrior.png

# Generate a -nolib variant of the zip in case libs ever get embedded.
enable-nolib-creation: yes

# The changelog is generated by .github/changelog.sh in the release workflow,
# one step ahead of the packager, so that commit trailers (Co-Authored-By and
# friends) can be filtered out of it — the packager's own generator copies raw
# commit bodies through and offers no filter. Declaring it here is what makes
# the packager use that file for the GitHub Release body and the CurseForge
# upload instead of building its own. The format is otherwise identical.
#
# CHANGELOG.md is deliberately absent from `ignore` above: the auto-generated
# one always shipped inside the zip, and this keeps that true. It is generated
# at build time and gitignored, never committed. If it is missing the packager
# prints a warning and falls back to generating its own, so the worst case here
# is the old behaviour rather than a broken release.
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown
